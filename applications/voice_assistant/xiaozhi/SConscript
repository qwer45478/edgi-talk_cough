from building import *
import os

cwd     = GetCurrentDir()

# Add all subdirectories to include path
path = []
path += [cwd]
path += [cwd + '/ui', cwd + '/iot', cwd + '/mcp', cwd + '/wake_word']
path += [cwd + '/ui/3d_demo/3d_demo/sample']
path += [cwd + '/ui/3d_demo/3d_demo/litegfx/adapt',
         cwd + '/ui/3d_demo/3d_demo/litegfx/plat',
         cwd + '/ui/3d_demo/3d_demo/litegfx/vglite/include',
         cwd + '/ui/3d_demo/3d_demo/sample/lz4',
         cwd + '/ui/3d_demo/3d_demo/sample/resource/AnimatedEmoji']

src = Glob('*.c') + Glob('*.cpp')

group = DefineGroup('xiaozhi', src, depend = [''], CPPPATH = path)

list = os.listdir(cwd)
for item in list:
    if os.path.isfile(os.path.join(cwd, item, 'SConscript')):
        group = group + SConscript(os.path.join(item, 'SConscript'))

Return('group')
